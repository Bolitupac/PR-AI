{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:docgen": "node --test tests-js/**/*.test.js",
        "test:js": "node --test tests-js/**/*.test.js",
        "test:js:unit": "node --test tests-js/unit/**/*.test.js",
        "test:js:integration": "node --test tests-js/integration/**/*.test.js",
        "test:js:system": "node --test tests-js/system/**/*.test.js",
        "test:js:functional": "node --test tests-js/**/functional/**/*.test.js",
        "test:js:nonfunctional": "node --test tests-js/**/non-functional/**/*.test.js"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.3.1"
    },
    "dependencies": {
        "diff2html": "^3.4.56",
        "marked": "^18.0.0",
        "mermaid": "^11.13.0"
    }
}
